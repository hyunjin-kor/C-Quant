{
  "name": "c-quant",
  "version": "1.5.0",
  "private": true,
  "description": "Carbon decision-support desktop for EU ETS, K-ETS, and China ETS — research, monitoring, and briefing.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hyunjin-kor/C-Quant.git"
  },
  "homepage": "https://github.com/hyunjin-kor/C-Quant#readme",
  "bugs": {
    "url": "https://github.com/hyunjin-kor/C-Quant/issues"
  },
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && electron .",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:node": "node --test tests/localization*.test.mjs",
    "test:all": "npm run test && npm run test:node",
    "build": "npm run type-check && vite build",
    "bundle:check": "node scripts/check-bundle-size.mjs",
    "encoding:check": "node scripts/check-encoding.mjs",
    "ci:verify": "node --check electron/main.js && node --check electron/preload.js && node --check electron/security.js && node --check electron/cache.js && node --check electron/logger.js && node --check electron/windowState.js && node --check electron/appSettings.js && node --check electron/liveSources.js && node --check electron/autoUpdate.js && node --check electron/sentry.js && node --check electron/exporters.js && node --check electron/watchlist.js && node --check electron/backtests.js && node --check electron/analytics.js && node --check electron/alerts.js && node --check electron/institutionalFeeds.js && node --check electron/freeFeeds.js && node --check scripts/check-calibration-freshness.mjs",
    "calibration:check": "node scripts/check-calibration-freshness.mjs",
    "preview": "vite preview",
    "smoke:dir": "powershell -ExecutionPolicy Bypass -File scripts/smoke-cquant.ps1 -Mode dir",
    "smoke:portable": "powershell -ExecutionPolicy Bypass -File scripts/smoke-cquant.ps1 -Mode portable",
    "smoke:release": "powershell -ExecutionPolicy Bypass -File scripts/smoke-cquant.ps1 -Mode all",
    "package:dir": "powershell -ExecutionPolicy Bypass -File scripts/stop-running-cquant.ps1 && npm.cmd run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win dir",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/stop-running-cquant.ps1 && npm.cmd run build && set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win portable",
    "package:nsis": "npm run build && electron-builder --win nsis",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder -mwl",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "capture": "node scripts/capture-screenshots.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "author": {
    "name": "hyunjin-kor",
    "email": "167435838+hyunjin-kor@users.noreply.github.com"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/pretendard": "^5.2.5",
    "@sentry/electron": "^7.12.0",
    "electron-updater": "^6.8.3",
    "exceljs": "^4.4.0",
    "lightweight-charts": "^5.2.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "overrides": {
    "uuid": ">=14.0.0",
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^9.2.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.20.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.5"
  },
  "build": {
    "appId": "com.cquant.desktop",
    "productName": "C-Quant",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "hyunjin-kor",
        "repo": "C-Quant"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "assets/app-icon.ico",
      "target": [
        "portable",
        "nsis"
      ],
      "signtoolOptions": {
        "signingHashAlgorithms": [
          "sha256"
        ]
      }
    },
    "portable": {
      "artifactName": "C-Quant-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "C-Quant-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.finance",
      "icon": "assets/app-icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "C-Quant-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "writeUpdateInfo": true
    },
    "linux": {
      "category": "Finance",
      "icon": "assets/app-icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "C-Quant-${version}-${arch}.${ext}"
    }
  }
}
