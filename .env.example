# C-Quant runtime configuration. Copy to .env when needed.

# Registered KRX Open API auth key (apply via the KRX Open API portal).
# Required to enable the K-ETS live card. When unset, the K-ETS adapter
# reports a configuration error and other markets continue to work.
# CQUANT_KRX_AUTH_KEY=

# Enable verbose logging in production builds.
# CQUANT_DEBUG=1

# Open Chromium DevTools when running `npm run dev`.
# CQUANT_OPEN_DEVTOOLS=1

# Disable the auto-updater (recommended for portable users on metered nets).
# CQUANT_DISABLE_UPDATER=1

# Optional Sentry DSN for production crash reporting. When unset, the app
# never contacts Sentry. Get a DSN from sentry.io for your project.
# CQUANT_SENTRY_DSN=https://example@o0.ingest.sentry.io/0

# === Code signing (used by electron-builder during `npm run package:*`) ===

# Windows Authenticode certificate (.pfx file path or HTTPS URL)
# CSC_LINK=
# CSC_KEY_PASSWORD=

# macOS Developer ID certificate (Keychain identity name) and notarization
# CSC_NAME=Developer ID Application: Your Name (TEAMID)
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Disable auto code-signing detection during local builds without certs
# CSC_IDENTITY_AUTO_DISCOVERY=false

# GitHub releases token (used by electron-builder publish + auto-updater feed)
# GH_TOKEN=
