# C-Quant runtime configuration. Copy to .env when needed.

# Override the public KRX sample auth key with your registered key.
# When unset, the bundled public sample key is used.
# CQUANT_KRX_AUTH_KEY=

# Enable verbose logging in production builds.
# CQUANT_DEBUG=1

# Open Chromium DevTools when running `npm run dev`.
# CQUANT_OPEN_DEVTOOLS=1
