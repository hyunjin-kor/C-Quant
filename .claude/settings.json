{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run calibration:check)",
      "Bash(npm run ci:verify)",
      "Bash(npm run type-check)",
      "Bash(npm run lint)",
      "Bash(npm run test)",
      "Bash(npm run test:node)",
      "Bash(npm run test:all)",
      "Bash(npm run build)",
      "Bash(npm run bundle:check)",
      "Bash(npm run e2e)",
      "Bash(node -e *)",
      "Bash(node --check *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "f=$(node -e \"process.stdout.write(JSON.parse(require('fs').readFileSync(0,'utf8')).tool_input?.file_path || '')\" 2>/dev/null); [ -z \"$f\" ] && exit 0; n=$(printf '%s' \"$f\" | tr '\\\\' '/'); case \"$n\" in *src/data/catalyst*.ts) npm run calibration:check ;; *electron/*.js) npm run ci:verify ;; esac",
            "timeout": 90,
            "statusMessage": "Verification gate (calibration:check / ci:verify)"
          }
        ]
      }
    ]
  }
}
